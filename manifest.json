{
  "manifest_version": 3,
  "name": "BondScore - Relationship & Mutuals Tracker",
  "version": "1.5.8",
  "description": "Local-first relationship layer for X, Threads & Bluesky. Private bond scores, mutuals CRM, DM analytics and group chat energy with zero backend.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://threads.net/*",
    "https://www.threads.net/*",
    "https://threads.com/*",
    "https://www.threads.com/*",
    "https://bsky.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "BondScore"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "core/platforms.js",
        "core/storage.js",
        "core/scoring.js",
        "core/deep-analyzer.js",
        "content/detector.js",
        "content/ui.js",
        "content/xchat-adapter.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://threads.net/*",
        "https://www.threads.net/*",
        "https://threads.com/*",
        "https://www.threads.com/*",
        "https://bsky.app/*"
      ],
      "js": [
        "core/platforms.js",
        "core/storage.js",
        "core/scoring.js",
        "core/deep-analyzer.js",
        "content/ui.js",
        "content/platform-adapters.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/styles.css"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://threads.net/*",
        "https://www.threads.net/*",
        "https://threads.com/*",
        "https://www.threads.com/*",
        "https://bsky.app/*"
      ]
    }
  ]
}
